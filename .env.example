# Puerto del servidor
PORT=3001

# Entorno: development | production
NODE_ENV=production

# URL del sitio en producción (para CORS)
SITE_URL=https://tudominio.com

# PostgreSQL (Hostinger)
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/NOMBRE_DB

# Clerk Auth
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Email (Gmail App Password)
EMAIL_USER=tu@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
ADMIN_EMAIL=admin@tudominio.com

# --- Seguridad del panel de administración ---
# SESSION_SECRET (obligatoria en producción) tambien deriva la clave que cifra el secreto del 2FA de los administradores:
# si la cambias, los admin tendrán que reconfigurar su 2FA. El 2FA se activa desde el propio panel (Seguridad > 2FA).
#    TOTP_LIMIT=10            (intentos de código 2FA por IP cada 15 min; por defecto 10)
# Certificado de Postgres: por defecto se cifra sin validar el certificado. Para validarlo, una de estas dos:
#    DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----   (PEM de la CA; en una línea con \n literales)
#    DB_SSL_REJECT_UNAUTHORIZED=1   (valida contra las CA del sistema)

# --- Desarrollo local (sin tocar producción) ---
# Solo necesitas:  npm install  y luego  npm run dev   (o doble clic en INICIAR.bat).
# La base de datos local se crea y se enciende sola; si falta DATABASE_URL usa una por defecto.
# Si el puerto de DATABASE_URL está bloqueado en tu equipo, se cambia solo a uno libre y se actualiza este archivo.
# En una base vacía carga el catálogo real (scripts/boats-snapshot.json).
#    NODE_ENV=development
#    DATABASE_URL=postgresql://postgres:postgres@localhost:54329/vendobote
#    SESSION_SECRET=cualquier-texto-largo

# --- Mirar la base REAL de Railway desde el local (solo lectura) ---
# En Railway: servicio Postgres > Connect > Public URL (si no existe, activa "TCP Proxy").
#    DATABASE_URL=<Public URL de Railway>
#    DB_SSL=1
#    DB_READONLY=1     (no migra, no siembra y Postgres rechaza cualquier escritura)

# --- Pago con tarjeta (AZUL, Página de Pago) ---
# El servidor nunca recibe datos de tarjeta: el cliente paga en el sitio de AZUL.
# Credenciales que entrega AZUL (no subir valores reales al repositorio; se configuran en Railway).
AZUL_MERCHANT_ID=
AZUL_MERCHANT_NAME=
AZUL_AUTH_KEY=
# test = https://pruebas.azul.com.do/PaymentPage/  |  prod = https://pagos.azul.com.do/PaymentPage/Default.aspx
AZUL_ENV=test
# Tasa de ITBIS como fracción (0.18 = 18 %). Se suma al monto solo en pagos con tarjeta. Por defecto 0.18.
AZUL_ITBIS_RATE=0.18
# SOLO DESARROLLO: URL del simulador local (npm run dev lo levanta con AZUL_ENV=test). Se ignora con NODE_ENV=production.
#    AZUL_PAYMENT_URL=http://localhost:4010/PaymentPage/
# En producción (NODE_ENV=production) el pago con tarjeta solo se habilita con AZUL_ENV=prod. Solo para una prueba puntual
# con credenciales de pruebas en producción: AZUL_ALLOW_TEST_IN_PROD=1 (se registra un aviso al arrancar; quitarla después).
#    AZUL_ALLOW_TEST_IN_PROD=
# Límite de /api/payments/azul/start por IP cada 15 min (por defecto 10).
#    AZUL_START_LIMIT=10
# Rango válido de la tasa USD→DOP para cobrar (por defecto 40 y 120). Fuera de él se rechaza el pago.
#    AZUL_RATE_MIN=40
#    AZUL_RATE_MAX=120
# Cada cuánto se liberan las retenciones con tarjeta vencidas (milisegundos; por defecto 60000).
#    CARD_EXPIRY_INTERVAL_MS=60000
# Dirección física del negocio (la exige AZUL en las páginas legales).
BUSINESS_ADDRESS=
